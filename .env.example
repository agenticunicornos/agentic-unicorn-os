VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Optional server-side agent runtime for Netlify Functions.
# Without these values, AGU.OS uses deterministic local agent logic.
# LLM_PROVIDER can be local, openai, openrouter, custom, or ollama.
LLM_PROVIDER=local
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
LLM_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
